spring:
  datasource:
    url: jdbc:mysql://localhost:3306/realtime_collaboration
    username: root
    password: root
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

server:
  port: 8080

jwt:
  secret: YOUR_BASE64_JWT_SECRET
  expiration: 86400000/target/
/package-lock.json
/src/main/resources/application.yaml
target/
